{
  "project": "rt-variability-benchmark",
  "config_version": "0.1",
  "status": "prespecified",
  "created_date": "2026-07-18",
  "seed": 20260718,
  "simulation_repetitions": 1000,
  "alpha": 0.05,
  "groups": {
    "names": ["Group A", "Group B"],
    "participants_per_group": 100
  },
  "reaction_time_model": {
    "distribution": "lognormal",
    "median_ms": 500.0,
    "baseline_log_sigma": 0.2,
    "higher_variability_log_sigma": 0.32,
    "default_trials_per_participant": 160,
    "minimum_valid_trials": 20,
    "valid_rt_range_ms": [100.0, 5000.0]
  },
  "scenarios": [
    {
      "id": "null_equal_groups",
      "description": "Same median and same variability in both groups",
      "group_a_log_sigma": 0.2,
      "group_b_log_sigma": 0.2,
      "outliers": {"enabled": false},
      "missingness": {"mechanism": "none", "target_rate": 0.0},
      "trial_counts": {"mechanism": "fixed", "value": 160}
    },
    {
      "id": "higher_variability",
      "description": "Same median with greater variability in Group B",
      "group_a_log_sigma": 0.2,
      "group_b_log_sigma": 0.32,
      "outliers": {"enabled": false},
      "missingness": {"mechanism": "none", "target_rate": 0.0},
      "trial_counts": {"mechanism": "fixed", "value": 160}
    },
    {
      "id": "higher_variability_with_outliers",
      "description": "Greater variability with 1% extreme slow-response outliers",
      "group_a_log_sigma": 0.2,
      "group_b_log_sigma": 0.32,
      "outliers": {
        "enabled": true,
        "rate": 0.01,
        "multiplier_distribution": "uniform",
        "multiplier_range": [2.0, 4.0]
      },
      "missingness": {"mechanism": "none", "target_rate": 0.0},
      "trial_counts": {"mechanism": "fixed", "value": 160}
    },
    {
      "id": "higher_variability_with_random_missingness",
      "description": "Greater variability with 15% randomly missing responses",
      "group_a_log_sigma": 0.2,
      "group_b_log_sigma": 0.32,
      "outliers": {"enabled": false},
      "missingness": {"mechanism": "mcar", "target_rate": 0.15},
      "trial_counts": {"mechanism": "fixed", "value": 160}
    },
    {
      "id": "higher_variability_with_slow_dependent_missingness",
      "description": "Greater variability with 15% slow-response-dependent missingness",
      "group_a_log_sigma": 0.2,
      "group_b_log_sigma": 0.32,
      "outliers": {"enabled": false},
      "missingness": {
        "mechanism": "slow_response_dependent",
        "target_rate": 0.15,
        "ranking_method": "within_participant_rt_percentile",
        "selection_weight": "increases_with_percentile"
      },
      "trial_counts": {"mechanism": "fixed", "value": 160}
    },
    {
      "id": "higher_variability_with_unequal_trial_counts",
      "description": "Greater variability with unequal trial counts between participants",
      "group_a_log_sigma": 0.2,
      "group_b_log_sigma": 0.32,
      "outliers": {"enabled": false},
      "missingness": {"mechanism": "none", "target_rate": 0.0},
      "trial_counts": {
        "mechanism": "discrete_uniform",
        "minimum": 80,
        "maximum": 160
      }
    }
  ],
  "participant_metrics": [
    {"id": "median_rt", "definition": "median of valid RT values"},
    {"id": "sd_rt", "definition": "sample standard deviation of valid RT values with ddof=1"},
    {"id": "cv_rt", "definition": "sample standard deviation divided by mean RT"},
    {"id": "mad_rt", "definition": "median absolute deviation from participant median, unscaled"},
    {"id": "iqr_rt", "definition": "75th percentile minus 25th percentile"}
  ],
  "group_test": {
    "method": "mann_whitney_u",
    "alternative": "two-sided",
    "alpha": 0.05
  },
  "evaluation": [
    "false_positive_rate",
    "statistical_power",
    "median_group_difference",
    "effect_size_stability",
    "valid_participant_rate"
  ],
  "missing_response_policy": {
    "rt_metrics": "exclude missing RT values",
    "reporting": "report missing-response rate separately",
    "imputation": "none"
  },
  "outputs": {
    "result_table": "results/v0.1/benchmark_results.csv",
    "summary_table": "results/v0.1/metric_summary.csv",
    "configuration_copy": "results/v0.1/benchmark_config.json",
    "reproducibility_log": "results/v0.1/reproducibility_log.json",
    "figure": "figures/v0.1/metric_performance.png"
  },
  "interpretation_boundary": "Simulation performance does not establish an ADHD mechanism, diagnosis, causal effect, treatment effect, or the Allostatic Sprint hypothesis."
}
