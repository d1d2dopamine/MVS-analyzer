<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <UseSystemDrawing>true</UseSystemDrawing>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AssemblyName>MVS_Analyzer</AssemblyName>
    <RootNamespace>MvsAnalyzer</RootNamespace>
    <Version>1.4.0</Version>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <!-- Must agree with app.manifest, otherwise ApplicationConfiguration.Initialize fights it. -->
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
  </PropertyGroup>
  <ItemGroup>
    <Compile Remove="MvsAnalyzer.Tests/**/*.cs" />
  </ItemGroup>
  <ItemGroup>
    <!-- Branding travels inside the published single file: window icon and in-app wordmark. -->
    <EmbeddedResource Include="app.ico" />
    <EmbeddedResource Include="Assets\inapp_logo.png" />
  </ItemGroup>
</Project>
