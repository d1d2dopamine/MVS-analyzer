  "fieldClasses": {
    "exact": [
      "schema versions",
      "application and engine versions within a release",
      "formula version and formula hash",
      "dataset SHA256",
      "settings hash",
      "seed and repetition counts",
      "scenario and track names",
      "metric registry and row order",
      "candidate/status/verdict strings",
      "failure counts and boolean flags"
    ],
    "numeric": [
      "p-values and adjusted p-values",
      "effect estimates and intervals",
      "calibrated FPR and power",
      "MDE values and power-curve values",
      "variance components and model parameters",
      "estimation bias, MSE and coverage",
      "benchmark rates and stability statistics"
    ],
    "operational": [
      "created timestamps",
      "run IDs containing timestamps",
      "absolute output paths",
      "generated output folder names",
      "machine description strings",
      "environment fingerprint when comparing different arithmetic environments",
      "wall-clock duration",
      "progress text"
    ]
  },
