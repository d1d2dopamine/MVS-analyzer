{
  "schemaVersion": 1,
  "contractId": "mvs-cli-v1",
  "status": "frozen-human-contract-with-additive-machine-json",
  "applicationVersion": "1.4.0",
  "engineVersion": "1.6.0",
  "stateSchemaVersion": 2,
  "resultSchemaVersion": 2,
  "manifestSchemaVersion": 2,
  "exitCodes": {
    "0": "completed",
    "1": "input-runtime-error-or-cancellation",
    "2": "scientific-or-numerical-diagnostic"
  },
  "streams": {
    "humanMode": {
      "stdout": "human-readable progress and summaries",
      "stderr": "errors and warnings"
    },
    "machineMode": {
      "stdout": "exactly one mvs-cli-result/v1 JSON object",
      "stderr": "progress/warnings unless --quiet suppresses progress"
    },
    "note": "--json is additive. Process exit-code meanings are unchanged."
  },
  "comparisonPolicies": {
    "exact": "Compare identity, schema, categorical decisions, counts, seeds, settings and hashes exactly.",
    "numeric": "Compare scientific floating-point values with an explicit tolerance. Never round before comparison.",
    "operational": "Do not treat timestamps, run IDs, absolute paths, machine descriptions or generated folder names as scientific equality fields."
  },
  "numericTolerance": {
    "sameEnvironmentAbsolute": 1e-12,
    "crossEnvironmentAbsolute": 1e-10,
    "relative": 1e-10,
    "note": "Cross-environment equality is tolerance-based because the project records arithmetic environment fingerprints rather than claiming bit-identical replay across environments."
  },
